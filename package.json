{
  "name": "cinebridge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Recomendação e formação de equipes audiovisuais",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.ts",
    "test:coverage": "c8 --all --include=src/**/*.ts --reporter=text --reporter=html --reporter=json-summary --check-coverage --lines=81 --statements=81 --functions=81 --branches=81 node --env-file-if-exists=.env --test test/*.test.ts test/integration/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "demo": "node scripts/demo.ts",
    "test:load": "node --env-file-if-exists=.env scripts/load.ts",
    "evaluate": "node scripts/evaluate.ts",
    "demo:familias": "node scripts/demo-families.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "c8": "^10.1.3",
    "typescript": "~5.9.3"
  }
}
