@startuml
skinparam classAttributeIconSize 0
hide empty members
package "HTTP" {
  class API_Fastify
}
package "Aplicação" {
  class ServicoEquipes {
    criar()
    aceitar()
    substituir()
    responder()
    reavaliar()
  }
  interface Repositorio
  class CatalogoProfissionais
  class CacheRecomendacoes
}
package "Domínio" {
  class Projeto { +aceitar(visitante) }
  class Profissional { +aceitar(visitante) }
  class Competencia
  class Avaliacao
  class Equipe
  class MembroEquipe
  class Recomendacao
  class Convite
  abstract class OrquestradorEquipe {
    +orquestrar()
    {abstract} #validarRestricoes()
    {abstract} #normalizarDados()
    {abstract} #posProcessar()
  }
  class OrquestradorPadrao
  interface RecomendacaoStrategy { +recomendar() }
  class SimilaridadeCosseno
  class FiltragemColaborativa
  class RegrasOrcamento
  interface VisitanteProjeto {
    +visitarProjeto()
    +visitarProfissional()
  }
  class ValidadorConsistencia
  class CalculadorCompatibilidade
  class GeradorRelatorio
}
package "Infraestrutura e observadores" {
  class RepositorioPostgres
  database PostgreSQL
  class ProcessadorEventos
  class BusEventos
  class EventEmitter
  interface Observador { +atualizar(evento, signal) }
  class NotificadorEmail
  class NotificadorInterno
  class AuditoriaRecomendacao
}
API_Fastify --> ServicoEquipes
ServicoEquipes --> Repositorio
ServicoEquipes --> CatalogoProfissionais
ServicoEquipes --> SistemaRecomendacao
SistemaRecomendacao --> CacheRecomendacoes
SistemaRecomendacao --> OrquestradorPadrao
CacheRecomendacoes --> OrquestradorPadrao
RepositorioPostgres ..|> Repositorio
RepositorioPostgres --> PostgreSQL : TypeORM / transações
OrquestradorPadrao --|> OrquestradorEquipe
OrquestradorEquipe --> RecomendacaoStrategy
SimilaridadeCosseno ..|> RecomendacaoStrategy
FiltragemColaborativa ..|> RecomendacaoStrategy
RegrasOrcamento ..|> RecomendacaoStrategy
Projeto "1" -- "1" Equipe
Projeto "1" -- "0..*" Recomendacao
Projeto "1" -- "0..*" Convite
Equipe "1" *-- "0..6" MembroEquipe
MembroEquipe --> Profissional
Convite --> Profissional
Profissional "1" *-- "0..*" Competencia
Profissional "1" *-- "0..*" Avaliacao
Projeto --> VisitanteProjeto : aceitar
Profissional --> VisitanteProjeto : aceitar
ValidadorConsistencia ..|> VisitanteProjeto
CalculadorCompatibilidade ..|> VisitanteProjeto
GeradorRelatorio ..|> VisitanteProjeto
ProcessadorEventos --> Repositorio : eventos confirmados na outbox
ProcessadorEventos --> BusEventos
BusEventos --> EventEmitter
BusEventos --> Observador : entrega assíncrona acompanhada
NotificadorEmail ..|> Observador
NotificadorInterno ..|> Observador
AuditoriaRecomendacao ..|> Observador
NotificadorEmail --> Repositorio
NotificadorInterno --> Repositorio
AuditoriaRecomendacao --> Repositorio
note right of NotificadorEmail
  Caixa de saída local persistida.
  Não utiliza provedor SMTP.
end note
note bottom of OrquestradorEquipe
  orquestrar é concreto e não sobrescrevível.
  As etapas protegidas variam nas subclasses.
end note

package "Criação (ATVII)" {
  interface FabricaProjeto {
    +criarProjeto(dados)
    +criarValidador(equipe)
    +criarRecomendador(projeto)
    +criarNotificador(destino)
    +criarRelatorio(equipe, profissionais)
  }
  class FabricaPadrao
  class FabricaDocumentario
  class FabricaAnimacao
  class FabricaPublicitario
  class RegistroFabricas
  class RegistroPrototipos
}
class Projeto {
  +clonar(): this
  +criarFabrica(): FabricaProjeto
}
class ProjetoDocumentario
class ProjetoAnimacao
class ProjetoPublicitario
FabricaPadrao ..|> FabricaProjeto
RegistroPrototipos o-- Projeto : guarda e clona
RegistroFabricas o-- FabricaProjeto
OrquestradorEquipe --> FabricaProjeto : injetada no construtor
SistemaRecomendacao --> RegistroFabricas
SistemaRecomendacao --> RegistroPrototipos
note right of RegistroPrototipos
  Prototype: cópia profunda preserva a classe.
  API cria outra identidade e recalcula a equipe.
end note

FabricaDocumentario --|> FabricaPadrao
ProjetoDocumentario --|> Projeto
ProjetoDocumentario ..> FabricaDocumentario : Factory Method
FabricaDocumentario ..> ProjetoDocumentario : cria
FabricaDocumentario ..> ValidadorDocumentario : cria
FabricaDocumentario ..> RecomendadorDocumentario : cria
FabricaDocumentario ..> NotificadorDocumentario : cria
FabricaDocumentario ..> RelatorioDocumentario : cria
ValidadorDocumentario ..|> VisitanteProjeto
RelatorioDocumentario ..|> VisitanteProjeto
RecomendadorDocumentario ..|> RecomendacaoStrategy
NotificadorDocumentario ..|> Observador

FabricaAnimacao --|> FabricaPadrao
ProjetoAnimacao --|> Projeto
ProjetoAnimacao ..> FabricaAnimacao : Factory Method
FabricaAnimacao ..> ProjetoAnimacao : cria
FabricaAnimacao ..> ValidadorAnimacao : cria
FabricaAnimacao ..> RecomendadorAnimacao : cria
FabricaAnimacao ..> NotificadorAnimacao : cria
FabricaAnimacao ..> RelatorioAnimacao : cria
ValidadorAnimacao ..|> VisitanteProjeto
RelatorioAnimacao ..|> VisitanteProjeto
RecomendadorAnimacao ..|> RecomendacaoStrategy
NotificadorAnimacao ..|> Observador

FabricaPublicitario --|> FabricaPadrao
ProjetoPublicitario --|> Projeto
ProjetoPublicitario ..> FabricaPublicitario : Factory Method
FabricaPublicitario ..> ProjetoPublicitario : cria
FabricaPublicitario ..> ValidadorPublicitario : cria
FabricaPublicitario ..> RecomendadorPublicitario : cria
FabricaPublicitario ..> NotificadorPublicitario : cria
FabricaPublicitario ..> RelatorioPublicitario : cria
ValidadorPublicitario ..|> VisitanteProjeto
RelatorioPublicitario ..|> VisitanteProjeto
RecomendadorPublicitario ..|> RecomendacaoStrategy
NotificadorPublicitario ..|> Observador

@enduml
